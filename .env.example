# Copy to .env and fill in. Compose fails if POSTGRES_PASSWORD or SECRET_KEY is unset.
#
#   cp .env.example .env
#
# Generate each secret with:
#   openssl rand -base64 36

# --- Required ---------------------------------------------------------------
POSTGRES_USER=quiz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quiz

# Signs session cookies. Must be >= 32 chars and must not stay "change-me".
SECRET_KEY=change-me-long-random

# --- Basics -----------------------------------------------------------------
# Public origin of the app. Used to build OAuth callback URLs, so it must match
# what the browser actually visits (https://your-domain in production).
BASE_URL=http://localhost:8080
QUIZ_HTTP_PORT=8080

# Session cookie: 0 for local http, 1 behind https
COOKIE_SECURE=0

# Local dev login (POST /api/v1/auth/dev/login) — never enable in production
DEV_AUTH=0

# --- OAuth (optional) -------------------------------------------------------
# The app works fully without these; progress just stays in the browser and is
# not synced across devices. Register the callback URL shown next to each pair.

# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Authorization callback URL: <BASE_URL>/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: <BASE_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional tuning (defaults from backend/api/settings.py) ----------------
#SESSION_TTL_DAYS=30
#RAW_UPLOAD_DIR=/data/raw
#MAX_RAW_BYTES=1048576
#MAX_RAW_PER_USER_PER_DAY=10
