# Copy to .env and fill in secrets. Compose fails if POSTGRES_PASSWORD or SECRET_KEY is unset.
POSTGRES_USER=quiz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quiz
SECRET_KEY=change-me-long-random
BASE_URL=https://quiz.khayrul.me
QUIZ_HTTP_PORT=8080

# Session cookie: 0 for local http, set to 1 behind https
COOKIE_SECURE=0

# Local dev login (POST /api/v1/auth/dev/login) — never enable in production
DEV_AUTH=0

# OAuth (optional — app works without login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Other settings have defaults in backend/api/settings.py
